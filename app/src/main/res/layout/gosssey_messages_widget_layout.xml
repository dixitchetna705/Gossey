<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/gosssey_widget_bg">

    <LinearLayout
        android:id="@+id/msg_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gosssey"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • Messages"
            android:textSize="12sp"
            android:textColor="#00EF60"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_msg_sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/msg_header"
        android:layout_marginTop="12dp"
        android:text="No Recent Chat"
        android:textColor="#01C6FF"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_msg_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_msg_sender"
        android:layout_marginTop="4dp"
        android:text="You do not have any new peer messages. Switch accounts or start chatting!"
        android:textColor="#EFEFEF"
        android:textSize="12sp"
        android:maxLines="3"/>
</RelativeLayout>
