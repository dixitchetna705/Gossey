<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/gosssey_widget_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gosssey"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • Daily Feed"
            android:textSize="12sp"
            android:textColor="#88FFFFFF"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_post_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginTop="12dp"
        android:text="Gosssey Loop"
        android:textColor="#00EF60"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_post_author"
        android:layout_marginTop="4dp"
        android:text="Create an account or login to post vector gradients!"
        android:textColor="#EFEFEF"
        android:textSize="12sp"
        android:maxLines="3"/>
</RelativeLayout>
